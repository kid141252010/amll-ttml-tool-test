{
	"$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
	"productName": "amll-ttml-tool",
	"version": "0.1.0",
	"identifier": "net.stevexmh.amll-ttml-tool",
	"build": {
		"frontendDist": "../dist",
		"devUrl": "http://localhost:5173",
		"beforeDevCommand": "pnpm dev",
		"beforeBuildCommand": "pnpm build"
	},
	"app": {
		"windows": [
			{
				"title": "",
				"label": "main",
				"width": 800,
				"height": 600,
				"resizable": true,
				"devtools": false,
				"fullscreen": false,
				"dragDropEnabled": false,
				"visible": false
			}
		],
		"security": {
			"csp": "default-src 'self' asset: customprotocol:; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https: asset:; font-src 'self' data:; connect-src 'self' https: wss: ipc: http://ipc.localhost; media-src 'self' data: blob: https: asset:; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'",
			"headers": {
				"Cross-Origin-Opener-Policy": "same-origin",
				"Cross-Origin-Embedder-Policy": "require-corp",
				"X-Content-Type-Options": "nosniff",
				"X-Frame-Options": "DENY",
				"Referrer-Policy": "strict-origin-when-cross-origin"
			}
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"createUpdaterArtifacts": true
	},
	"plugins": {
		"updater": {
			"pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZCMTA0MTJFNjg1NTIyMTcKUldRWElsVm9Ma0VRKzRRUW05VlkvWXlVQTAxQ2VzTitZNlJvNkFiNzhoRW9jQTBEVEhUeVhqMFMK",
			"endpoints": [
				"https://github.com/amll-dev/amll-ttml-tool/releases/latest/download/latest.json"
			]
		}
	}
}
